{
  "name": "skynet-security-explorer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/terminal.js && vite",
    "build": "vite build",
    "preview": "vite preview",
    "terminal:up": "node scripts/terminal.js",
    "terminal:down": "node -e \"try { require('child_process').execSync(process.platform === 'win32' ? 'taskkill /F /IM ttyd.exe' : 'pkill -f ttyd'); } catch {}\""
  },
  "dependencies": {
    "@fontsource-variable/recursive": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0"
  }
}
